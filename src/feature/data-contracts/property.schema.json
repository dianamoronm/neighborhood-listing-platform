{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PropertyListing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "address",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "zip_code",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "state", "zip_code"],
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "zip_code": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        }
      }
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "integer",
      "minimum": 0
    },
    "square_feet": {
      "type": "integer",
      "minimum": 0
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "local_sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sponsor_id", "name", "type"],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["lender", "mover", "insurer", "other"]
          }
        }
      }
    }
  }
}